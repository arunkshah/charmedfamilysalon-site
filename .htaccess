# ============================================================
# Charmed Family Salon — .htaccess
# Apache 2.4+
# ============================================================

# ─── Default document ───
DirectoryIndex index.html

# ─── Disable directory listings ───
Options -Indexes

# ============================================================
# REWRITES — HTTPS, canonical host, redirects
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block AI Bots / Crawlers to save bandwidth and prevent model training
  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT-User|ClaudeBot|Google-Extended|Applebot-Extended|CCBot|PerplexityBot|cohere-ai|Omgilibot|Diffbot|Bytespider|ImagesiftBot|Amazonbot|FacebookBot) [NC]
  RewriteRule ^ - [F,L]

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host: redirect www → non-www (canonicals use bare domain)
  RewriteCond %{HTTP_HOST} ^www\.charmedfamilysalon\.com$ [NC]
  RewriteRule ^(.*)$ https://charmedfamilysalon.com/$1 [L,R=301]

  # 301: /index.html → / (single canonical homepage URL)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]


  # 301: trailing-slash pretty URLs that some legacy canonicals pointed to
  RewriteRule ^services/?$ /services.html [L,R=301]
  RewriteRule ^about/?$    /about.html    [L,R=301]
  RewriteRule ^gallery/?$  /gallery.html  [L,R=301]
  RewriteRule ^contact/?$  /contact.html  [L,R=301]
</IfModule>

# ============================================================
# COMPRESSION (gzip)
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ============================================================
# BROWSER CACHING
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                                "access plus 1 month"

  # HTML — short cache so content updates appear quickly
  ExpiresByType text/html                       "access plus 1 hour"

  # CSS / JS
  ExpiresByType text/css                        "access plus 1 month"
  ExpiresByType application/javascript          "access plus 1 month"
  ExpiresByType text/javascript                 "access plus 1 month"

  # Images
  ExpiresByType image/jpeg                      "access plus 1 year"
  ExpiresByType image/png                       "access plus 1 year"
  ExpiresByType image/webp                      "access plus 1 year"
  ExpiresByType image/avif                      "access plus 1 year"
  ExpiresByType image/svg+xml                   "access plus 1 year"
  ExpiresByType image/x-icon                    "access plus 1 year"

  # Fonts
  ExpiresByType font/woff                       "access plus 1 year"
  ExpiresByType font/woff2                      "access plus 1 year"
  ExpiresByType application/font-woff           "access plus 1 year"
  ExpiresByType application/font-woff2          "access plus 1 year"

  # Feeds / data
  ExpiresByType application/xml                 "access plus 1 hour"
  ExpiresByType text/xml                        "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Long cache for static assets (immutable)
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|gif|svg|ico|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|htm|xml)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # ─── Security headers ───
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Remove server fingerprinting
  Header unset X-Powered-By
</IfModule>

# ============================================================
# LITESPEED CACHE
# ============================================================
<IfModule LiteSpeed>
  # Enable LiteSpeed cache
  CacheLookup on

  # Cache HTML pages for 1 hour
  RewriteEngine On
  RewriteRule .* - [E=cache-control:max-age=3600]

  # Cache static assets for 1 year
  RewriteRule \.(css|js)$ - [E=cache-control:max-age=2592000]
  RewriteRule \.(jpg|jpeg|png|webp|avif|gif|svg|ico|woff|woff2)$ - [E=cache-control:max-age=31536000]
</IfModule>

# ============================================================
# CHARSET & MIME
# ============================================================
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType image/svg+xml          .svg .svgz
  AddType image/webp             .webp
  AddType image/avif             .avif
  AddType font/woff              .woff
  AddType font/woff2             .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ============================================================
# BLOCK ACCESS TO SENSITIVE FILES
# ============================================================
<FilesMatch "^\.(htaccess|htpasswd|env|git)">
  Require all denied
</FilesMatch>
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op])|~)$">
  Require all denied
</FilesMatch>

